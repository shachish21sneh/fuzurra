# Fuzurra Industries - Environment Configuration Template
# Copy this file to .env and fill in your private credentials.

# SMTP Configuration (cPanel Mail / SMTP Gateway)
SMTP_HOST=mail.fuzurra.in
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=info@fuzurra.in
SMTP_PASS=YOUR_SMTP_PASSWORD_HERE
SMTP_FROM_EMAIL=info@fuzurra.in
SMTP_FROM_NAME="Fuzurra Industries Pvt. Ltd."

# Notification Recipient
NOTIFICATION_RECIPIENT_EMAIL=krishnagzp@gmail.com
